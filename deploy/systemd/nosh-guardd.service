[Unit]
Description=Nosh guarded runner supervisor
Documentation=file:@@NOSH_GUARD_PREFIX@@/share/doc/notty/nosh-guard.md
After=apparmor.service docker.service nosh-guard-bpffs.service tetragon.service network-online.target
Requires=docker.service nosh-guard-bpffs.service
Wants=apparmor.service tetragon.service network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/nosh-guard/nosh-guard.env
ExecStartPre=@@NOSH_GUARD_PREFIX@@/libexec/nosh-guard/nosh-guard-host-verify --service
ExecStart=@@NOSH_GUARD_PREFIX@@/bin/nosh-guardd
ExecStopPost=@@NOSH_GUARD_PREFIX@@/bin/nosh-guard-fail-closed
Restart=on-failure
RestartSec=2
OOMPolicy=stop
KillMode=mixed
RuntimeDirectory=nosh-guard
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=nosh-guard
StateDirectoryMode=0700
ConfigurationDirectory=nosh-guard
ConfigurationDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
# The daemon creates /run/nosh-guardd.sock. AppArmor policy replacement uses
# securityfs. ProtectKernelTunables explicitly protects the bpffs mount on
# systemd 255; permit only the pre-created Guard child directory, rather than
# trying to override protection at the same /sys/fs/bpf mount path.
ReadWritePaths=/var/lib/nosh-guard /run
ReadWritePaths=/sys/fs/bpf/nosh-guard
ReadWritePaths=-/sys/kernel/security/apparmor
KeyringMode=private
LockPersonality=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
