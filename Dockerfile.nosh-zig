# Build the base first: ./scripts/build-nosh.sh
# Then build with the same USERNAME used for the base image:
# docker build -f Dockerfile.nosh-zig --build-arg USERNAME="$(id -un)" -t nosh-zig .
# Launch from your project directory: nosh --image nosh-zig
ARG NOSH_IMAGE=nosh:latest
FROM ${NOSH_IMAGE}

USER root
ARG USERNAME=notty

RUN apt-get update && apt-get install -y --no-install-recommends \
    xauth \
    xcompmgr \
    xvfb \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Official Zig 0.17.0 archives, pinned separately for each supported architecture.
RUN set -eu; \
    case "$(dpkg --print-architecture)" in \
      amd64) \
        zig_arch=x86_64; \
        zig_sha256=1cbe9df9f27e6b78d14ccbca43b6703a404ef79ef1c463de901d7f088d4e2026; \
        ;; \
      arm64) \
        zig_arch=aarch64; \
        zig_sha256=9e8d11661d4ae3bd57702a3832781e23ad151dde5798e16a5ccd503f65234ff8; \
        ;; \
      *) echo 'Unsupported Zig architecture' >&2; exit 1 ;; \
    esac; \
    curl --fail --location --retry 3 \
      "https://ziglang.org/download/0.17.0/zig-${zig_arch}-linux-0.17.0.tar.xz" \
      --output /tmp/zig.tar.xz; \
    printf '%s  %s\n' "$zig_sha256" /tmp/zig.tar.xz | sha256sum --check -; \
    mkdir -p /opt/zig; \
    tar -xJf /tmp/zig.tar.xz --strip-components=1 -C /opt/zig; \
    rm /tmp/zig.tar.xz; \
    ln -s /opt/zig/zig /usr/local/bin/zig; \
    test "$(zig version)" = 0.17.0; \
    command -v Xvfb; \
    command -v xvfb-run; \
    command -v xcompmgr; \
    id "$USERNAME" >/dev/null

USER ${USERNAME}
