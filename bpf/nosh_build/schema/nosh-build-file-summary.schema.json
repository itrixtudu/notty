{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notty.invalid/schema/nosh-build-file-summary-v2.json",
  "title": "Nosh build metadata-only file-open summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordKind",
    "metadataOnly",
    "timestampUnixNs",
    "targetCgroupId",
    "path",
    "aggregationKey",
    "firstObservedNs",
    "lastObservedNs",
    "opens",
    "accessCounts"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "recordKind": { "const": "file-summary" },
    "metadataOnly": { "const": true },
    "timestampUnixNs": { "$ref": "#/$defs/uint64" },
    "targetCgroupId": { "$ref": "#/$defs/uint64" },
    "path": { "type": "string", "minLength": 1, "maxLength": 255 },
    "aggregationKey": { "const": "resolved-path" },
    "firstObservedNs": { "$ref": "#/$defs/uint64" },
    "lastObservedNs": { "$ref": "#/$defs/uint64" },
    "opens": { "$ref": "#/$defs/uint64" },
    "accessCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write", "execute", "create"],
      "properties": {
        "read": { "$ref": "#/$defs/uint64" },
        "write": { "$ref": "#/$defs/uint64" },
        "execute": { "$ref": "#/$defs/uint64" },
        "create": { "$ref": "#/$defs/uint64" }
      }
    }
  },
  "$defs": {
    "uint64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    }
  }
}
