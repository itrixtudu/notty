{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notty.dev/schemas/nosh-guard/http-content-manifest.schema.json",
  "title": "Nosh HTTP content-addressed replay manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "apiVersion", "kind", "generatedAt", "runId", "mode",
    "entries", "contentHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "apiVersion": { "const": "notty.dev/v1alpha1" },
    "kind": { "const": "NoshHttpContentManifest" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$" },
    "mode": { "enum": ["offline-replay", "live-buffer-verify"] },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/entry" }
    },
    "contentHash": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nullableDigest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method", "scheme", "hostname", "port", "requestTargetDigest",
        "requestBodyDigest", "representationHeadersDigest", "credentialed"
      ],
      "properties": {
        "method": { "type": "string", "pattern": "^(?!HEAD$)[A-Z][A-Z0-9!#$%&'*+.^_`|~-]{0,31}$" },
        "scheme": { "enum": ["http", "https"] },
        "hostname": { "type": "string", "minLength": 1, "maxLength": 253 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "requestTargetDigest": { "$ref": "#/$defs/digest" },
        "requestBodyDigest": { "$ref": "#/$defs/nullableDigest" },
        "representationHeadersDigest": { "$ref": "#/$defs/digest" },
        "credentialed": { "const": false }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "location": { "type": "null" } } },
          "then": { "properties": { "locationDigest": { "type": "null" } } },
          "else": {
            "properties": {
              "locationDigest": { "$ref": "#/$defs/digest" },
              "status": {
                "allOf": [
                  { "minimum": 300, "maximum": 399 },
                  { "not": { "const": 304 } }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "locationDigest": { "type": "null" } } },
          "then": { "properties": { "location": { "type": "null" } } },
          "else": { "properties": { "location": { "type": "string" } } }
        }
      ],
      "required": [
        "status", "bodyDigest", "bodyBytes", "contentType", "contentEncoding",
        "location", "locationDigest"
      ],
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 200,
          "maximum": 599,
          "not": { "enum": [206, 304] }
        },
        "bodyDigest": { "$ref": "#/$defs/digest" },
        "bodyBytes": { "type": "integer", "minimum": 0 },
        "contentType": { "type": ["string", "null"], "minLength": 1, "maxLength": 1024, "pattern": "^[^\\r\\n]+$" },
        "contentEncoding": { "type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "^[^\\r\\n]+$" },
        "location": { "type": ["string", "null"], "minLength": 1, "maxLength": 65536, "pattern": "^[^\\r\\n]+$" },
        "locationDigest": { "$ref": "#/$defs/nullableDigest" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestKey", "request", "response", "sourceExchangeId", "capturedAt"],
      "properties": {
        "requestKey": { "$ref": "#/$defs/digest" },
        "request": { "$ref": "#/$defs/request" },
        "response": { "$ref": "#/$defs/response" },
        "sourceExchangeId": { "$ref": "#/$defs/digest" },
        "capturedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
