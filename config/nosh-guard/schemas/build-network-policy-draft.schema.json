{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notty.dev/schemas/nosh-guard/build-network-policy-draft.schema.json",
  "title": "Editable Nosh build network policy draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "apiVersion", "kind", "generatedAt", "editable", "authoritative", "source", "defaults", "rules", "notes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "apiVersion": { "const": "notty.dev/v1alpha1" },
    "kind": { "const": "NoshBuildNetworkPolicyDraft" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "editable": { "const": true },
    "authoritative": { "const": false },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "candidateHash", "evidenceManifestHash"],
      "properties": {
        "runId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "candidateHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "evidenceManifestHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["egress"],
      "properties": { "egress": { "const": "deny-after-approval" } }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision", "direction", "peer", "transport", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "decision": { "enum": ["review", "allow", "deny"] },
          "direction": { "const": "egress" },
          "peer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fqdn", "ip"],
            "properties": {
              "fqdn": { "type": ["string", "null"] },
              "ip": { "type": ["string", "null"] }
            }
          },
          "transport": {
            "type": "object",
            "additionalProperties": false,
            "required": ["protocol", "ports"],
            "properties": {
              "protocol": { "enum": ["tcp", "udp"] },
              "ports": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 65535 } }
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source"],
            "properties": { "source": { "type": ["string", "null"] } }
          }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
