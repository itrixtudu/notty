{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notty.dev/schemas/nosh-guard/review/dsse-envelope.schema.json",
  "title": "Nosh DSSE envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["payloadType", "payload", "signatures"],
  "properties": {
    "payloadType": { "type": "string", "minLength": 1, "maxLength": 255 },
    "payload": { "type": "string", "minLength": 1, "maxLength": 11184820, "contentEncoding": "base64" },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyid", "sig"],
        "properties": {
          "keyid": { "$ref": "common.schema.json#/$defs/hash" },
          "sig": { "type": "string", "minLength": 1, "maxLength": 344, "contentEncoding": "base64" }
        }
      }
    }
  }
}
