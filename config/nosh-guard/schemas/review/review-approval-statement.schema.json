{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notty.dev/schemas/nosh-guard/review/review-approval-statement.schema.json",
  "title": "Nosh durable review approval statement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion", "kind", "schemaVersion", "issuedAt", "reviewer", "audience",
    "bundleDigest", "graphDigest", "proposalSetDigest", "decisionSetDigest",
    "policyIrDigest", "targetReviewSetDigest", "baselineDigest", "scopeDigest",
    "confirmationDigest"
  ],
  "properties": {
    "apiVersion": { "const": "notty.dev/v1alpha1" },
    "kind": { "const": "NoshReviewApprovalStatement" },
    "schemaVersion": { "const": 1 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "reviewer": { "type": "string", "minLength": 1, "maxLength": 255 },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "bundleDigest": { "$ref": "common.schema.json#/$defs/hash" },
    "graphDigest": { "$ref": "common.schema.json#/$defs/hash" },
    "proposalSetDigest": { "$ref": "common.schema.json#/$defs/hash" },
    "decisionSetDigest": { "$ref": "common.schema.json#/$defs/hash" },
    "policyIrDigest": { "$ref": "common.schema.json#/$defs/hash" },
    "targetReviewSetDigest": { "$ref": "common.schema.json#/$defs/hash" },
    "baselineDigest": {
      "oneOf": [{ "$ref": "common.schema.json#/$defs/hash" }, { "type": "null" }]
    },
    "scopeDigest": { "$ref": "common.schema.json#/$defs/hash" },
    "confirmationDigest": { "$ref": "common.schema.json#/$defs/hash" }
  }
}
