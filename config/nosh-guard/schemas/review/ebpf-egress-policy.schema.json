{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notty.dev/schemas/nosh-guard/review/ebpf-egress-policy.schema.json",
  "title": "Nosh reviewed eBPF egress policy leaf",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion", "kind", "schemaVersion", "createdAt", "backend", "subject",
    "bindings", "defaults", "dns", "platformContainment", "rules"
  ],
  "properties": {
    "apiVersion": { "const": "notty.dev/v1alpha1" },
    "kind": { "const": "NoshEbpfEgressPolicy" },
    "schemaVersion": { "const": 2 },
    "createdAt": { "type": "string", "format": "date-time" },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "abi", "objectDigest"],
      "properties": {
        "target": { "const": "guard-ebpf" },
        "abi": { "const": "nosh-egress-v2" },
        "objectDigest": { "$ref": "common.schema.json#/$defs/hash" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectId", "scopeDigest", "workspaceKey", "workspaceIdentity",
        "workspaceDigest", "imageDigest"
      ],
      "properties": {
        "subjectId": { "$ref": "common.schema.json#/$defs/stableId" },
        "scopeDigest": { "$ref": "common.schema.json#/$defs/hash" },
        "workspaceKey": { "type": "string", "pattern": "^(?:[a-f0-9]{64}|sha256:[a-f0-9]{64})$" },
        "workspaceIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dev", "ino"],
          "properties": {
            "dev": { "$ref": "common.schema.json#/$defs/decimal" },
            "ino": { "$ref": "common.schema.json#/$defs/decimal" }
          }
        },
        "workspaceDigest": { "$ref": "common.schema.json#/$defs/hash" },
        "imageDigest": { "$ref": "common.schema.json#/$defs/hash" }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphDigest", "decisionSetDigest", "policyIrDigest",
        "targetContextDigest"
      ],
      "properties": {
        "graphDigest": { "$ref": "common.schema.json#/$defs/hash" },
        "decisionSetDigest": { "$ref": "common.schema.json#/$defs/hash" },
        "policyIrDigest": { "$ref": "common.schema.json#/$defs/hash" },
        "targetContextDigest": { "$ref": "common.schema.json#/$defs/hash" }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["egress"],
      "properties": { "egress": { "const": "deny" } }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolvers", "maximumGrantTtlSeconds", "exactNames",
        "wildcardSuffixes", "tcp", "udp"
      ],
      "properties": {
        "resolvers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 64 }
        },
        "maximumGrantTtlSeconds": { "const": 300 },
        "exactNames": { "const": true },
        "wildcardSuffixes": { "const": true },
        "tcp": { "type": "boolean" },
        "udp": { "const": true }
      }
    },
    "platformContainment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "ipv4PrefixLength", "ipv6PrefixLength"],
      "properties": {
        "strategy": { "const": "per-run-docker-bridge-gateways" },
        "ipv4PrefixLength": { "const": 32 },
        "ipv6PrefixLength": { "const": 128 }
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "effect", "direction", "peer", "transport", "evidenceRefs",
          "decisionRefs"
        ],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/stableId" },
          "effect": { "const": "allow" },
          "direction": { "const": "egress" },
          "peer": { "$ref": "common.schema.json#/$defs/peer" },
          "transport": { "$ref": "common.schema.json#/$defs/transport" },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/stableId" }
          },
          "decisionRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/stableId" }
          }
        }
      }
    }
  }
}
