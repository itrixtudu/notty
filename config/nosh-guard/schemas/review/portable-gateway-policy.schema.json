{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notty.dev/schemas/nosh-guard/review/portable-gateway-policy.schema.json",
  "title": "Nosh portable gateway policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "schemaVersion",
    "target",
    "platform",
    "bindings",
    "subject",
    "defaults",
    "nat",
    "rules"
  ],
  "properties": {
    "apiVersion": { "const": "notty.dev/v1alpha1" },
    "kind": { "const": "NoshPortableGatewayPolicy" },
    "schemaVersion": { "const": 1 },
    "target": {
      "enum": ["gateway-pf", "gateway-ipfw", "gateway-ipfilter"]
    },
    "platform": {
      "enum": ["openbsd", "freebsd", "illumos", "netbsd"]
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graphDigest", "decisionSetDigest", "policyIrDigest"],
      "properties": {
        "graphDigest": { "$ref": "common.schema.json#/$defs/hash" },
        "decisionSetDigest": { "$ref": "common.schema.json#/$defs/hash" },
        "policyIrDigest": { "$ref": "common.schema.json#/$defs/hash" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceIpv4", "gatewayIpv4", "uplinkInterface"],
      "properties": {
        "sourceIpv4": { "type": "string", "format": "ipv4" },
        "gatewayIpv4": { "type": "string", "format": "ipv4" },
        "uplinkInterface": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,15}$"
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forwarding"],
      "properties": { "forwarding": { "const": "deny" } }
    },
    "nat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "const": "uplink-interface-address" } }
    },
    "rules": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "table", "peer", "transport"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "table": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "peer": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "value"],
                "properties": {
                  "kind": { "const": "ipv4-cidr" },
                  "value": {
                    "type": "string",
                    "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[0-9]|[12][0-9]|3[0-2])$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "value"],
                "properties": {
                  "kind": { "const": "fqdn" },
                  "value": { "type": "string", "minLength": 3, "maxLength": 253 }
                }
              }
            ]
          },
          "transport": {
            "type": "object",
            "additionalProperties": false,
            "required": ["protocol", "ports", "icmpType", "icmpCode"],
            "properties": {
              "protocol": { "enum": ["tcp", "udp"] },
              "ports": {
                "type": "array",
                "minItems": 1,
                "maxItems": 65535,
                "uniqueItems": true,
                "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
              },
              "icmpType": { "type": "null" },
              "icmpCode": { "type": "null" }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["target"],
        "properties": { "target": { "const": "gateway-pf" } }
      },
      "then": { "properties": { "platform": { "const": "openbsd" } } }
    },
    {
      "if": {
        "required": ["target"],
        "properties": { "target": { "const": "gateway-ipfw" } }
      },
      "then": { "properties": { "platform": { "const": "freebsd" } } }
    },
    {
      "if": {
        "required": ["target"],
        "properties": { "target": { "const": "gateway-ipfilter" } }
      },
      "then": { "properties": { "platform": { "enum": ["illumos", "netbsd"] } } }
    }
  ]
}
