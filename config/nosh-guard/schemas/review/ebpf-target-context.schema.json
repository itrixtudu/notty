{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notty.dev/schemas/nosh-guard/review/ebpf-target-context.schema.json",
  "title": "Nosh Guard eBPF projection target context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion", "kind", "schemaVersion", "createdAt", "backendAbi",
    "objectDigest", "subject", "capabilities", "resolvers",
    "platformContainment", "contentHash"
  ],
  "properties": {
    "apiVersion": { "const": "notty.dev/v1alpha1" },
    "kind": { "const": "NoshGuardEbpfTargetContext" },
    "schemaVersion": { "const": 2 },
    "createdAt": { "type": "string", "format": "date-time" },
    "backendAbi": { "const": "nosh-egress-v2" },
    "objectDigest": { "$ref": "common.schema.json#/$defs/hash" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceKey", "workspaceIdentity", "imageDigest"],
      "properties": {
        "workspaceKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "workspaceIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dev", "ino"],
          "properties": {
            "dev": { "$ref": "common.schema.json#/$defs/decimal" },
            "ino": { "$ref": "common.schema.json#/$defs/decimal" }
          }
        },
        "imageDigest": { "$ref": "common.schema.json#/$defs/hash" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atomicPolicyGeneration", "cgroupConnect", "cgroupSendmsg",
        "cgroupSkb", "dnsParser", "exactPlatformContainment", "ipv6",
        "tcpDns", "ttlGrants"
      ],
      "properties": {
        "atomicPolicyGeneration": { "type": "boolean" },
        "cgroupConnect": { "type": "boolean" },
        "cgroupSendmsg": { "type": "boolean" },
        "cgroupSkb": { "type": "boolean" },
        "dnsParser": { "type": "boolean" },
        "exactPlatformContainment": { "const": true },
        "ipv6": { "type": "boolean" },
        "tcpDns": { "type": "boolean" },
        "ttlGrants": { "type": "boolean" }
      }
    },
    "resolvers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 64 }
    },
    "platformContainment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "ipv4PrefixLength", "ipv6PrefixLength"],
      "properties": {
        "strategy": { "const": "per-run-docker-bridge-gateways" },
        "ipv4PrefixLength": { "const": 32 },
        "ipv6PrefixLength": { "const": 128 }
      }
    },
    "contentHash": { "$ref": "common.schema.json#/$defs/hash" }
  }
}
