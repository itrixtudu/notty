{
  "apiVersion": "notty.dev/v1alpha1",
  "kind": "NoshTetragonRuleFragments",
  "metadata": {
    "name": "dangerous-syscall-review-example",
    "reviewOnly": true
  },
  "spec": {
    "kprobes": [
      {
        "call": "sys_bpf",
        "syscall": true,
        "selectors": [
          {
            "matchNamespaces": [
              {
                "namespace": "Cgroup",
                "operator": "In",
                "values": [
                  "{cgroupNamespace}"
                ]
              }
            ],
            "matchActions": [
              {
                "action": "Override",
                "argError": -1
              }
            ]
          }
        ]
      },
      {
        "call": "sys_mount",
